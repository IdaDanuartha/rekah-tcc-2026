# =============================================
# Rekah — Environment Variables
# =============================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role (server-side only, jangan expose ke client)
# Isi setelah didapat dari Supabase dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=

# AI Models (Primary: OpenAI GPT, Fallback: Gemini Flash Models)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Fonnte (WhatsApp API)
# Isi setelah credentials diberikan
FONNTE_API_KEY=
FONNTE_DEVICE_TOKEN=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Portal Pelapor (login OTP WhatsApp)
# Rahasia untuk tanda tangan cookie sesi pelapor.
# Generate: openssl rand -base64 32   (jika kosong, fallback ke SUPABASE_SERVICE_ROLE_KEY)
REPORTER_SESSION_SECRET=
# Kode OTP demo untuk juri tanpa akses WhatsApp. Kosongkan di produksi.
# Jika diisi (mis. 123456), kode ini selalu diterima saat verifikasi.
REPORTER_DEMO_OTP=
